<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if template.name == 'index' %}{{ shop.name }}{% else %}{{ page_title }} — {{ shop.name }}{% endif %}</title>
{%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&display=swap" rel="stylesheet">
{%- if template.name == 'index' -%}
  {{ 'home.css' | asset_url | stylesheet_tag }}
{%- else -%}
  {{ 'sage.css' | asset_url | stylesheet_tag }}
{%- endif %}
<style>[hidden] { display: none !important; }</style>
<script>window.OFFGRID_CART = {{ cart | json }};</script>
{{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  {%- unless template.name == 'index' -%}
    <nav class="site-nav{% if template.name == 'collection' %} over{% endif %}" aria-label="Primary">
      {%- render 'nav-links' -%}
    </nav>
  {%- endunless -%}

  {{ content_for_layout }}

  {%- render 'site-footer' -%}

<script src="{{ 'offgrid-cart.js' | asset_url }}" defer></script>
<script>
  /* fade sections in as they scroll into view */
  (() => {
    const rv = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) { rv.forEach(el => el.classList.add('in')); return; }
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .15 });
    rv.forEach(el => io.observe(el));
  })();
</script>
</body>
</html>
