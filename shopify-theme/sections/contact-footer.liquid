<footer id="contact" aria-label="Contact">
  <div class="row">
    <div class="brand">{{ shop.name | upcase | escape }}</div>
    <div><h4>Email</h4><p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email | escape }}</a></p></div>
    <div><h4>Phone</h4><p>{{ section.settings.phone | escape }}</p></div>
    <div><h4>Follow</h4><p>{{ section.settings.handle | escape }}</p></div>
  </div>
  <p class="fine">&copy; {{ shop.name | upcase | escape }}. {{ section.settings.fine | escape }}</p>
</footer>

{% schema %}
{
  "name": "Contact footer",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "email", "label": "Email", "default": "reach.offgrid@gmail.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+00 000 000 0000" },
    { "type": "text", "id": "handle", "label": "Social handle", "default": "@yourhandle" },
    { "type": "text", "id": "fine", "label": "Fine print", "default": "Own every breath." }
  ]
}
{% endschema %}
