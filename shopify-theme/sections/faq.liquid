<section id="faq" aria-label="Frequently asked questions">
  <header class="faq-head">{% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2><div class="line"></div></header>
  {%- for block in section.blocks %}
    <details class="qa" {{ block.shopify_attributes }}>
      <summary>{{ block.settings.question | escape }}</summary>
      <div class="ans">{{ block.settings.answer }}</div>
    </details>
  {%- endfor %}
</section>

{% schema %}
{
  "name": "Questions",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "info": "Optional line above the heading." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Questions" }]
}
{% endschema %}
