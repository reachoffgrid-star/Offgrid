<section id="story" aria-label="About {{ shop.name | escape }}">
  <div class="inner">
    <p class="eyebrow reveal">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="tagline reveal">{{ section.settings.tagline | escape }}</h2>
    <div class="rule2 reveal"></div>
    <p class="copy reveal">{{ section.settings.copy | escape }}</p>
    {%- if section.blocks.size > 0 -%}
    <div class="trio">
      {%- for block in section.blocks -%}
      <article class="reveal" {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>
      {%- endfor -%}
    </div>
    {%- endif -%}
    <a class="cta reveal" href="{% render 'shop-url' %}">{{ section.settings.cta_label | escape }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Air Purifier Necklaces" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Own your breath." },
    { "type": "textarea", "id": "copy", "label": "Text", "default": "OFFGRID air purifier necklaces are made to sit close to where you breathe. Light on the chest, easy to forget you are wearing, and ready to go wherever you go: the commute, the office, the long trip home. Clean air, on your own terms." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop Air Purifiers" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Worn close" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Sits near your breathing zone, so fresher air is right where you need it." }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
